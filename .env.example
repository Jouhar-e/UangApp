# Copy this file to `.env` and fill in the values (never commit .env)

# Groq — https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Google Sign-In — https://console.cloud.google.com/apis/credentials
# Wajib di Android: OAuth 2.0 Client ID tipe "Web application" (bukan Android/iOS)
GOOGLE_SERVER_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# Opsional — OAuth Client ID tipe "iOS" (untuk build iPhone)
# GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
